# PostgreSQL 18（配合 docker-compose.postgres.yml 使用）
# 请替换为随机生成的高强度密码；不要提交实际 .env 文件。
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# 可选：不填写时使用下列默认值。
POSTGRES_USER=any_auto_register
POSTGRES_DB=any_auto_register

# 应用容器连接 PostgreSQL 的 URL。使用 docker-compose.postgres.yml 时可不填写，
# 该文件会根据上面的 POSTGRES_* 自动生成连接串。
# 若使用外部 PostgreSQL，请取消下一行注释并填写实际地址；密码中的 @ : / ? 等字符需 URL 编码。
# DATABASE_URL=postgresql+psycopg://any_auto_register:change-me-to-a-long-random-password@127.0.0.1:5432/any_auto_register

# 可选：应用 HTTP 端口绑定（默认 8000:8000）
# APP_PORT_BIND=127.0.0.1:8000

# 可选：运行时日志和凭据加密密钥目录（默认 ./data）
# APP_RUNTIME_BIND=./data

# PostgreSQL 200 注册并发的连接池。网络等待不持有连接，60 个连接足够；
# 若运行多个应用容器，请按实例数与 PostgreSQL max_connections 重新评估。
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=10

# SQLite 仅限单 Web 进程且最多 40 注册并发；PostgreSQL 下可按部署平台调整。
WEB_CONCURRENCY=1
SQLITE_DB_POOL_SIZE=8
SQLITE_DB_POOL_TIMEOUT=10

# 注册、补 RT、绑 2FA 在单个应用进程内共享的总并发预算（最大 200）。
TASK_GLOBAL_MAX_CONCURRENCY=200

# 单个代理允许同时被几个账号使用（默认 1）。代理数量不足时 worker 会等待租约。
PROXY_MAX_CONCURRENT_PER_IP=1

# 外部服务链路的进程内并发预算。限制覆盖完整账号流程，防止邮箱轮询、
# 接码或 OpenAI 授权请求在 200 worker 下集体触发限流。
OPENAI_MAX_CONCURRENCY=200
MAIL_API_MAX_CONCURRENCY=100
SMS_API_MAX_CONCURRENCY=100

# 手机接码高并发：仅限制对应 HTTP 请求，不限制整个账号等待验证码的生命周期。
# PostgreSQL 200 并发推荐 30 / 80 / 25；SQLite 40 并发推荐 12 / 24 / 8。
SMS_RENT_MAX_CONCURRENCY=30
SMS_POLL_MAX_CONCURRENCY=80
SMS_CLOSE_MAX_CONCURRENCY=25

# 退款健康检查：最早未完成 job 超过 5 分钟、或队列超过 100 条会返回 unhealthy/503。
SMS_REFUND_ALERT_OLDEST_SECONDS=300
SMS_REFUND_ALERT_QUEUE_DEPTH=100

# cleanup job 会无限退避重试，达到第六次后每小时重试；不会因次数上限被丢弃。
